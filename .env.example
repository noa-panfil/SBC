# Application
NEXT_PUBLIC_APP_URL=https://seclinbasketclub.fr

# Authentification
# Génération conseillée : openssl rand -base64 32
NEXTAUTH_SECRET=

# Base de données principale
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=seclin-bc

# Base de données boutique
# Les accès SHOP_DB_* peuvent reprendre ceux de la base principale.
SHOP_DB_HOST=localhost
SHOP_DB_PORT=3306
SHOP_DB_USER=root
SHOP_DB_PASSWORD=
SHOP_DB_NAME=sbc_boutique

# Paiement Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mails Resend — boutique et formulaire de contact
RESEND_API_KEY=
SHOP_FROM_EMAIL="Seclin Basket Club <commandes@seclinbasketclub.fr>"
SHOP_REPLY_TO_EMAIL=seclinbc@gmail.com
SHOP_NOTIFICATION_EMAIL=seclinbc@gmail.com

# Surcharges facultatives pour le formulaire de contact
# CONTACT_FROM_EMAIL="Seclin Basket Club <contact@seclinbasketclub.fr>"
# CONTACT_NOTIFICATION_EMAIL=seclinbc@gmail.com
# CONTACT_DEV_NOTIFICATION_EMAIL=

# Google Analytics — facultatif
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
