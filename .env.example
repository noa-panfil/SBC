# Base de données MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=seclin-bc

# Configuration Next.js / NextAuth
# Générer une valeur unique d'au moins 32 caractères : openssl rand -base64 32
NEXTAUTH_SECRET=
NEXT_PUBLIC_APP_URL=https://seclinbasketclub.fr

# Deuxième base MySQL réservée à la boutique
# SHOP_DB_HOST/USER/PASSWORD peuvent être omis si le même serveur et le même compte MySQL sont utilisés.
SHOP_DB_HOST=localhost
SHOP_DB_PORT=3306
SHOP_DB_USER=root
SHOP_DB_PASSWORD=
SHOP_DB_NAME=sbc_boutique

# Boutique Stripe (paiement unique, aucune clé publique requise)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# E-mails de la boutique (Resend)
RESEND_API_KEY=
SHOP_FROM_EMAIL=Seclin Basket Club <commandes@seclinbasketclub.fr>
SHOP_REPLY_TO_EMAIL=seclinbc@gmail.com
SHOP_NOTIFICATION_EMAIL=seclinbc@gmail.com

# Notifications Push (Optionnel)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:contact@seclinbasketclub.fr

# Google Analytics (Optionnel)
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
